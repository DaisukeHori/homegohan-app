# ネストされた旧リポジトリ (本番モバイルビルドに不要)
homegohan-app/

# Root の node_modules (EAS が apps/mobile/node_modules を別途 install するため不要)
node_modules/

# Web アプリのビルド成果物 (ルート直下のみ除外、apps/mobile/src 等は除外しない)
.next/
.vercel/
/src/
/public/

# supabase/ はアプリのビルドに不要だが、アプリが import するファイルだけは残す
# (apps/mobile/src/lib/ai-consent.ts → supabase/functions/_shared/ai-consent.ts。#1154)。
# 親のディレクトリを除外すると下のファイルを否定で戻せないので、段ごとに「中身を除外 → 次の段だけ戻す」と書く。
# 否定の規則 (!) のディレクトリには末尾の / を付けない。EAS (eas-cli) はディレクトリを末尾の / なしの名前で
# 照合するので、`!/supabase/functions/` と書くとディレクトリに当たらず、`/supabase/*` で除外されたままになる。
# アプリが supabase/ の別のファイルを import するようになったら、最後の段に否定の行を足す
# (足し忘れは tests/mobile-easignore-bundle-inputs.test.ts が落とす)。
/supabase/*
!/supabase/functions
/supabase/functions/*
!/supabase/functions/_shared
/supabase/functions/_shared/*
!/supabase/functions/_shared/ai-consent.ts

# テスト / playwright
tests/
playwright-report/
test-results/
e2e/

# EAS でビルドしない apps
apps/web/

# ビルド成果物
**/ios/build/
**/ios/Pods/
**/ios/DerivedData/
**/android/build/
**/android/app/build/
**/android/.gradle/

# キャッシュ
.expo/
.expo-shared/
.metro-cache/
.gradle/
.cxx/
.turbo/

# カバレッジ
coverage/

# OS / IDE
.DS_Store
.vscode/
.idea/

# ログ
*.log

# ソースマップ
*.map
