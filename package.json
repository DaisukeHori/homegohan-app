{
  "name": "homegohan",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:env": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-env.mjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "test:e2e": "playwright test",
    "test:e2e:mvp": "playwright test tests/e2e/0[1-5]-*.spec.ts --reporter=list",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report tests/e2e/.report",
    "test:e2e:install": "playwright install --with-deps chromium",
    "diagnostic:v4-benchmark": "node scripts/diagnostics/v4-benchmark.js",
    "mobile:start": "npm --workspace apps/mobile run start",
    "mobile:ios": "npm --workspace apps/mobile run ios",
    "mobile:android": "npm --workspace apps/mobile run android",
    "test:e2e:reset-data": "bash apps/mobile/maestro/scripts/reset-test-users.sh",
    "types:supabase": "npx supabase@2.62.10 gen types typescript --local --schema public --workdir .supabase-local"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@google/genai": "^1.44.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.37.0",
    "@vercel/functions": "^3.10.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "focus-trap-react": "^12.0.3",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.554.0",
    "next": "16.4.1",
    "openai": "^6.9.1",
    "react": "^19.2.8",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.33.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  },
  "overrides": {
    "react-native": {
      "@types/react": "~19.3.0"
    },
    "@react-native/jest-preset": {
      "babel-jest": "~30.5.2",
      "jest-environment-node": "~30.5.2"
    }
  }
}
