# 必須: Supabase（公開情報）と Web API（BFF）の基点。この 3 つは必須 (src/lib/env.ts の REQUIRED_MOBILE_ENV_NAMES)
# 入っていないビルドは、開発中はエラー (Supabase は起動時に「[mobile] Missing env: ...」で止まる) か設定エラーの画面になり、
# リリースビルド (preview / production) は「アプリの設定が不足しています」の画面になる (#1182 / #1434)。
# EAS Build では、EAS の環境変数に登録しておく (eas.json の env には書いていない)
# EXPO_PUBLIC_API_BASE_URL は、いまアプリが動いている Web (EXPO_PUBLIC_WEB_URL と同じ) を指す。
# homegohan.com は、サイトを移すまで別のサービスを指しているので使わない (移す手順は docs/operations/email-domain.md)
EXPO_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=xxx
EXPO_PUBLIC_API_BASE_URL=https://homegohan-app.vercel.app

# WebView が表示する Web アプリのオリジン（末尾スラッシュ・パスは不要）
# 未設定なら https://homegohan-app.vercel.app。WebView はこのオリジンに固定され (#1036)、
# 他オリジンへの遷移（レシピの外部リンク等）は OS の既定ブラウザで開く。
# セッション引き継ぎ用 code の発行 API (/api/auth/native-bridge/code) もこのオリジンへ送る。
# 本番の最終 URL（リダイレクト後のオリジン）を設定すること。
# http:// は開発ビルド（__DEV__）か localhost / 10.0.2.2 等の開発用ホストだけ。
# 本番ビルドで http:// を設定しても、refresh_token を平文で送らないよう既定の https オリジンに戻る。
EXPO_PUBLIC_WEB_URL=https://homegohan-app.vercel.app

# 環境
EXPO_PUBLIC_APP_ENV=development

# EAS push token 取得に必要。`eas init` で発行された UUID を設定する
# 本番・preview ビルドでは EAS Secrets に登録して自動注入される
EXPO_PUBLIC_EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# bot 対策: Cloudflare Turnstile のサイトキー（任意。公開してよい値。#1165）
# ログイン・新規登録・パスワード再設定の画面に Turnstile を出す。未設定なら出さない（今までどおり）。
# 本番・preview ビルドでは EAS の環境変数に登録する。ビルド時に埋め込まれるので、変えたら新しいビルドが要る。
# 実機で確認してから本番ビルドに入れること。Supabase で CAPTCHA を有効にする時期は docs/operations/auth-protection.md を参照。
# Cloudflare 公式のテスト用サイトキー 1x00000000000000000000AA（常に成功）は、開発用ビルドで使える。
# WebView は EXPO_PUBLIC_WEB_URL（既定 https://homegohan-app.vercel.app）のホスト名で動くので、
# そのホスト名を Cloudflare のウィジェットの許可ホスト名に入れておくこと。
EXPO_PUBLIC_TURNSTILE_SITE_KEY=

# 設定画面・プロフィール画面の「お問い合わせ」の宛先 (#1194)。メールアドレスの形でなければ既定値を使う。
# 未設定なら既定のアドレス (src/lib/siteConfig.ts)。ビルド時に埋め込まれるので、変えたらアプリをビルドし直す。
# 「利用規約」「プライバシーポリシー」は、WebView が開く Web (EXPO_PUBLIC_WEB_URL。未設定なら既定の Web) の /terms /privacy を開く。
# ログイン前に読める公開ページ (このアプリについて・利用規約など。src/components/PublicPage.tsx) の「Web版を開く」も、同じ Web のページを開く (#1049 F7-19)。
# 切り替えの手順は docs/operations/email-domain.md
# EXPO_PUBLIC_SUPPORT_EMAIL=support@homegohan.com




# アプリ内課金 (RevenueCat) の公開 SDK キー (billing/03 §8.10。公開してよい値。RevenueCat のプロジェクトの API keys の Public app-specific key)
# iOS は APPLE (appl_ で始まる)、Android は GOOGLE (goog_ で始まる)。未設定のビルドでは、プランとお支払いの画面にストアの購入を出さない
# (購入の復元のボタンは押せない形で出す)。本番・preview ビルドでは EAS の環境変数に登録する。ビルド時に埋め込まれるので、変えたら新しいビルドが要る。
# 購入は Expo Go では動かない (開発ビルドが要る。eas.json の development の profile)
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=
