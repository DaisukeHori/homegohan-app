# Supabase（公開情報）
EXPO_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=xxx

# Web API（必要になったら）
EXPO_PUBLIC_API_BASE_URL=https://homegohan.com

# 環境
EXPO_PUBLIC_APP_ENV=development

# EAS push token 取得に必要。`eas init` で発行された UUID を設定する
# 本番・preview ビルドでは EAS Secrets に登録して自動注入される
EXPO_PUBLIC_EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Web 版 (Next.js) のオリジン。WebView の表示先と、「Web版を開く」リンク (PublicPage) に使う。
# 末尾のスラッシュ・パスは不要。未設定なら https://homegohan-app.vercel.app (本番の Web)。
# EXPO_PUBLIC_API_BASE_URL (API の呼び出し先) とは別の設定値。以前は PublicPage が API の方を流用していた。
EXPO_PUBLIC_WEB_URL=https://homegohan-app.vercel.app

# 設定画面・プロフィール画面の「お問い合わせ」の宛先 (#1194)。メールアドレスの形でなければ既定値を使う。
# 未設定なら既定のアドレス (src/lib/siteConfig.ts)。ビルド時に埋め込まれるので、変えたらアプリをビルドし直す。
# 「利用規約」「プライバシーポリシー」は、WebView が開く Web (EXPO_PUBLIC_WEB_URL。未設定なら既定の Web) の /terms /privacy を開く。
# 切り替えの手順は docs/operations/email-domain.md
# EXPO_PUBLIC_SUPPORT_EMAIL=support@homegohan.com

# PostHog (分析)。どちらも任意で、EXPO_PUBLIC_POSTHOG_KEY が未設定なら計測は送らない。
# KEY は公開してよい Project API Key (phc_ で始まるもの)。
# HOST は、空のままか省略すると Web と共通の既定ホスト (packages/shared の POSTHOG_DEFAULT_HOST) を使う。
# 別のリージョン (EU など) を使うときだけ、そのホストを書く。既定ホストの文字列はここに書き写さない
# (ホストを変えたときに食い違うため。src/__tests__/config/posthog-default-host.test.ts が検査する)。
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
