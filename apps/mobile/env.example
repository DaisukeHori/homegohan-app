# Supabase（公開情報。この 2 つは必須）
# 入っていないビルドは、開発中は起動時に「[mobile] Missing env: ...」のエラーで止まり、
# リリースビルド (preview / production) は「アプリの設定が不足しています」の画面になる (#1182)。
# EAS Build では、EAS の環境変数に登録しておく (eas.json の env には書いていない)
EXPO_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=xxx

# Web API（必要になったら）
EXPO_PUBLIC_API_BASE_URL=https://homegohan.com

# 環境
EXPO_PUBLIC_APP_ENV=development

# EAS push token 取得に必要。`eas init` で発行された UUID を設定する
# 本番・preview ビルドでは EAS Secrets に登録して自動注入される
EXPO_PUBLIC_EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# bot 対策: Cloudflare Turnstile のサイトキー（任意。公開してよい値。#1165）
# ログイン・新規登録・パスワード再設定の画面に Turnstile を出す。未設定なら出さない（今までどおり）。
# 本番・preview ビルドでは EAS の環境変数に登録する。ビルド時に埋め込まれるので、変えたら新しいビルドが要る。
# 実機で確認してから本番ビルドに入れること。Supabase で CAPTCHA を有効にする時期は docs/operations/auth-protection.md を参照。
# Cloudflare 公式のテスト用サイトキー 1x00000000000000000000AA（常に成功）は、開発用ビルドで使える。
# WebView は EXPO_PUBLIC_WEB_URL（既定 https://homegohan-app.vercel.app）のホスト名で動くので、
# そのホスト名を Cloudflare のウィジェットの許可ホスト名に入れておくこと。
EXPO_PUBLIC_TURNSTILE_SITE_KEY=

# 設定画面・プロフィール画面の「お問い合わせ」の宛先 (#1194)。メールアドレスの形でなければ既定値を使う。
# 未設定なら既定のアドレス (src/lib/siteConfig.ts)。ビルド時に埋め込まれるので、変えたらアプリをビルドし直す。
# 「利用規約」「プライバシーポリシー」は、WebView が開く Web (EXPO_PUBLIC_WEB_URL。未設定なら既定の Web) の /terms /privacy を開く。
# 切り替えの手順は docs/operations/email-domain.md
# EXPO_PUBLIC_SUPPORT_EMAIL=support@homegohan.com



