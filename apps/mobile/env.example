# Supabase（公開情報）
EXPO_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=xxx

# Web API（必要になったら）
EXPO_PUBLIC_API_BASE_URL=https://homegohan.com

# WebView が表示する Web アプリのオリジン（末尾スラッシュ・パスは不要）
# 未設定なら https://homegohan-app.vercel.app。WebView はこのオリジンに固定され (#1036)、
# 他オリジンへの遷移（レシピの外部リンク等）は OS の既定ブラウザで開く。
# セッション引き継ぎ用 code の発行 API (/api/auth/native-bridge/code) もこのオリジンへ送る。
# 本番の最終 URL（リダイレクト後のオリジン）を設定すること。
# http:// は開発ビルド（__DEV__）か localhost / 10.0.2.2 等の開発用ホストだけ。
# 本番ビルドで http:// を設定しても、refresh_token を平文で送らないよう既定の https オリジンに戻る。
EXPO_PUBLIC_WEB_URL=https://homegohan-app.vercel.app

# 環境
EXPO_PUBLIC_APP_ENV=development

# EAS push token 取得に必要。`eas init` で発行された UUID を設定する
# 本番・preview ビルドでは EAS Secrets に登録して自動注入される
EXPO_PUBLIC_EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx



