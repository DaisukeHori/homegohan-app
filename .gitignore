# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/tests/e2e/.output/
/tests/e2e/.report/
/tests/e2e/.auth/
# E2E fixture 画像 (大容量のためリポジトリ管理外。CI では別途配置すること)
/tests/e2e/fixtures/*.jpg
/tests/e2e/fixtures/*.jpeg
/tests/e2e/fixtures/*.png
/tests/e2e/fixtures/*.webp

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
.tmp/
*.pem

# 認証情報・秘密鍵 (#1114 #1139)。除外されているかは tests/no-committed-credentials.test.ts が検査する
# ブラウザの通信記録 (HAR) には、ログインのパスワードやアクセストークンが平文で入る
*.har
# Google Play のサービスアカウント鍵などの置き場 (apps/mobile/eas.json の serviceAccountKeyPath が ../../secrets/ を指す)
/secrets/
*service-account*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!apps/mobile/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# expo / react-native
.expo
apps/mobile/.expo
apps/mobile/dist
apps/mobile/web-build
apps/mobile/.eas*
!apps/mobile/.easignore

# データセット（CSVは大きいのでGitに含めない）
data/raw/

# Supabase Edge Functions
/deno.lock
supabase/functions/deno.lock

# scripts/supabase-local.sh が組み立てるローカル Supabase の作業ディレクトリ
/.supabase-local/

# Claude Code agent worktrees (transient, never tracked)
.claude/worktrees/
