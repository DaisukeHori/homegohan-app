# =====================================================
# homegohan 環境変数サンプル
# =====================================================
# ローカル開発: このファイルを `.env.local` にコピーして実値を設定
# CCCloud: 環境設定 UI の "Environment Variables" に同形式で貼り付け
# Vercel: Project Settings > Environment Variables から登録
#
# 詳細手順は ENV_SETUP.md と SETUP_ENV.sh を参照
#
# 検査: `npm run check:env` で、このアプリが読む環境変数が .env.local (と実行中の環境変数) に
#   そろっているかを確かめられる (値は表示しない)。
#   必須 (無いとアプリが動かない): NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
#   それ以外はすべて任意 (無くても動くが、機能が縮退する)。変数の一覧と「無いと何が起きるか」は src/lib/env.ts (#1182)
#   コードで環境変数を読むときは `process.env.X!` と書かず、src/lib/env-required.ts / src/lib/env.ts の getter を使う
# =====================================================

# ---- Supabase (必須) -----------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Storage の publishable key (画像系)
SUPABASE_STORAGE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY の古い別名。画像生成ジョブ (lib/meal-image-jobs.ts) がこちらを先に読む。通常は設定しない
# SERVICE_ROLE_JWT=

# ---- bot 対策: Cloudflare Turnstile のサイトキー (任意。#1165) ------
# ログイン・新規登録・パスワード再設定の画面に Turnstile を出す。未設定なら出さない (今までどおり)。
# サイトキーは公開してよい値 (秘密キーは Supabase のダッシュボードにだけ入れ、ここには書かない)。
# NEXT_PUBLIC_* はビルド時に埋め込まれるので、Vercel で変えたら再デプロイが要る。
# ローカル開発・e2e では Cloudflare 公式のテスト用サイトキー 1x00000000000000000000AA (常に成功) が使える。
# 本番に入れる時期と、Supabase で CAPTCHA を有効にする手順は docs/operations/auth-protection.md を参照。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Turnstile の秘密キー (任意。サーバー専用。#1165)。ログインに 3 回続けて失敗したメールアドレスで次にログインするとき、
# POST /api/auth/login がトークンを Cloudflare に問い合わせて確かめる。サイトキーと組で設定する。
# 未設定 (またはサイトキーが未設定) なら確かめずに通す (サーバーの起動後、最初のログインの要求で、その旨のログが 1 回だけ出る)。
# ローカル開発・e2e では Cloudflare 公式のテスト用の秘密キー 1x0000000000000000000000000000000AA (常に成功) が使える。
# Supabase のダッシュボードで CAPTCHA を有効にするときは、ここを空にする (docs/operations/auth-protection.md §6)。
TURNSTILE_SECRET_KEY=
# ログインの連続失敗の回数を 0 に戻すまでの、最後の失敗からの時間 (分。任意。サーバー専用。#1165)。1〜10080 の整数。
# 回数が 3 回以上のメールアドレスでは、ボットの確認を求める (ログインに続けて失敗しても、アカウントはロックしない)。
# 未設定なら 1440 分 (24 時間)。ログインに成功しても 0 に戻る。
AUTH_LOGIN_FAILURE_RESET_MINUTES=
# 新しい端末・地域からのログインを本人にメールで知らせるか (任意。サーバー専用。#1190)。on / off。
# off にすると、毎分の cron (GET /api/cron/login-alerts) は判定して印を付けるが、メールを送らない (障害・移行の間に止める用)。
# 未設定なら on。on / off 以外の値も on に戻す (warn ログに変数名だけを残す)。メールが届くには送信元ドメインの検証が要る (docs/operations/email-domain.md)。
AUTH_LOGIN_ALERT=
# 運営ロールの二段階認証 (TOTP) の登録の猶予の終わり (任意。サーバー専用。#1176。docs/design/cross/12-operator-mfa.md §12.2)。
# super_admin / admin / finance / org_industrial_doctor で未登録の運営を、この日時まで通す (運営の画面にバナーが出る)。
# 登録済みの運営には効かない (ログインのたびに 6 桁を求める)。ISO 8601 + タイムゾーン必須 (例: 2026-11-01T00:00:00+09:00)。
# 未設定なら猶予なし (未登録の運営は次のアクセスから登録を求められる)。不正な値も猶予なしとして扱い、warn ログを残す。
OPERATOR_MFA_ENFORCE_FROM=

# ---- App メタ (任意。本番では設定する) -----------------
# サイトの URL。メールの中のリンク・招待や譲渡の URL・ページの OGP / canonical・robots.txt の基点になる
# (src/lib/site-config.ts, #1194)。末尾の / は付けない。ビルド時に埋め込まれるので、本番で変えたら再デプロイする。
# 未設定なら、いま動いているサイトの URL (https://homegohan-app.vercel.app)。
# homegohan.com へ切り替える手順は docs/operations/email-domain.md
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 注: NEXT_PUBLIC_APP_NAME は、現在コードから読まれていない
NEXT_PUBLIC_APP_NAME=homegohan
# 運営画面に出す環境名 (未設定なら NODE_ENV)
# NEXT_PUBLIC_APP_ENV=
# 運営画面のサーバー側 fetch が呼ぶ、このアプリ自身の URL (最優先。未設定なら VERCEL_URL、なければ http://localhost:<PORT>)
# NEXTAUTH_URL=
# このサーバーが待ち受けるポート (未設定なら 3000)。next start -p で 3000 以外にするときは同じ値を入れる (運営画面のサーバー側 fetch の宛先)
# PORT=
# Vercel デプロイ時は自動注入される
# NEXT_PUBLIC_VERCEL_ENV=
# VERCEL_ENV=
# VERCEL_URL=

# ---- AI 系 (任意。機能を使うときに必要) -----------------
# 画像認識・チャット (Gemini)
GOOGLE_AI_STUDIO_API_KEY=
# GOOGLE_AI_STUDIO_API_KEY の別名 (どちらか一方でよい)
# GOOGLE_GEN_AI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash-exp
GEMINI_CLASSIFY_MODEL=gemini-2.0-flash-exp
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# xAI (Grok) — fast-llm.ts (献立 / チャット)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# fast-llm が使うモデル名 (未設定ならコードの既定)
# FAST_LLM_MODEL=

# OpenAI (一部エンドポイントで利用)
OPENAI_API_KEY=

# Anthropic (将来の産業医アドバイス用)
# ANTHROPIC_API_KEY=

# ---- 課金 (Stripe。任意) -------------------------------
# operator-F 開発時に必須。本番 / test を切り替え
# アプリの起動には不要。無いと Stripe との照合・価格の同期が動かない。購入・Billing Portal・解約の予約も 503 (billing/01)
STRIPE_SECRET_KEY=
# Stripe の Webhook の署名の秘密 (whsec_…)。無いと POST /api/webhooks/stripe が 503 (billing/01 §8.3)
STRIPE_WEBHOOK_SECRET=
# ---- アプリ内課金 (RevenueCat。任意。billing/03) --------
# RevenueCat の秘密の API キー (sk_…。Project Settings → API keys の secret key)。ストアの契約を取り直す (GET /v1/subscribers)。
# 無いと POST /api/webhooks/revenuecat と POST /api/billing/iap/sync が 503 (アプリの購入の画面は開ける)
REVENUECAT_SECRET_API_KEY=
# RevenueCat の Webhook の署名の秘密 (Integrations → Webhooks で署名を有効にすると 1 回だけ表示される)。無いと POST /api/webhooks/revenuecat が 503 (billing/03 §8.2)
REVENUECAT_WEBHOOK_SECRET=
# ストアの購読の定期の取り直し (GET /api/cron/iap-reconcile。毎時 41 分。billing/04)。どちらも任意。
# 1 回に選ぶ利用者の数 (1〜40。空なら 40 人。下げる向きだけ) と、期限の後に取り直しても live のままの行を次に取り直すまでの間隔 (1〜168 時間。空なら 6 時間)。
# 整数だけ。範囲外・整数でない値は既定値に戻る (warn ログに変数名だけが残る)。
IAP_RECONCILE_BATCH_SIZE=
IAP_RECONCILE_RECHECK_HOURS=

# ---- メール送信 (Resend) -------------------------------
# サポート問合せ・申込通知
RESEND_API_KEY=
# Resend の Webhook の署名の秘密 (whsec_ で始まる値)。Resend の管理画面で Webhook (宛先 https://<サイト>/api/webhooks/resend、
# イベント email.bounced / email.complained) を登録すると出る。未設定なら Webhook を 503 で断り、
# ハードバウンス・苦情の宛先が宛先停止リスト (email_blacklist) に入らない (#1184)。手順は ENV_SETUP.md。
RESEND_WEBHOOK_SECRET=
# メールの送信元 (From)。Resend で検証済みのドメインのアドレスにする (未検証だと Resend が送信を断る)。
# 「表示名 <アドレス>」の形か、アドレスだけ。未設定なら従来の送信元 (src/lib/site-config.ts, #1194)。
# EMAIL_FROM="ほめゴハン <noreply@mail.homegohan.com>"
# 問い合わせ先 (サポート窓口) のメールアドレス。メールの文面・お問い合わせ画面・プライバシーポリシー・招待画面に出る。
# 未設定なら従来のアドレス。ビルド時に埋め込まれるので、本番で変えたら再デプロイする。
# NEXT_PUBLIC_SUPPORT_EMAIL=support@homegohan.com
# サポートチケットへの返信メール (顧客向け) の返信先 (任意)。
# 未設定なら送信元は noreply のままで、メール本文でお問い合わせフォーム (/contact) へ誘導する。
SUPPORT_REPLY_TO=
# メールの送信待ち (email_outbox。#1193)。sendEmail は送信待ちに登録するだけで、Vercel Cron が毎分 GET /api/cron/email-outbox を呼んで送る。
# 試行の上限 (最初の 1 回を含む。1〜20 の整数) と、1 回の cron で送る件数の上限 (1〜100 の整数)。
# 空なら既定の 6 回・20 件。範囲外・整数でない値は既定値に戻る (warn ログが残る)。
EMAIL_OUTBOX_MAX_ATTEMPTS=
EMAIL_OUTBOX_BATCH_SIZE=

# ---- 招待 URL ベース (membership) -----------------------
# 招待・譲渡の承諾・メンバー管理画面のリンクの基点は、ふだん NEXT_PUBLIC_APP_URL に従う (#1194)。
# これは「招待系のリンクだけ別のホストにしたいとき」の上書き用で、設定すると NEXT_PUBLIC_APP_URL より優先される。
# ふだんは設定しない (サイトの URL を変えたのに招待のリンクだけ古いホストのまま残る原因になる)。
# NEXT_PUBLIC_INVITE_BASE_URL=
ADMIN_NOTIFICATION_EMAIL=

# ---- Rate limit (Upstash Redis。ローカルは任意、本番は設定する) ----
# AI 系 API の分あたり上限、招待メール・参加リクエスト・譲渡提案メールの送信回数の上限 (#1163)、
# お問い合わせフォームの IP ごとの上限 (#1197) に使う。いずれも src/lib/rate-limit.ts の共通の仕組み。
# ローカル開発は未設定でよい (サーバープロセス内のメモリで数える)。
# 本番 (Vercel) では必ず Production に設定すること。未設定だと上限がサーバーインスタンスごとの
# 数え直しになり、1 日あたりの上限 (招待メールなど) が実質効かない。詳細は ENV_SETUP.md を参照。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- 監視 ----------------------------------------------
# エラーは app_logs テーブルに記録し、/super-admin/logs で見る (src/lib/db-logger.ts)。
# 性能の計測は Vercel Speed Insights だけで、環境変数は要らない (有効・無効は Vercel のダッシュボードで切り替える)。
# Sentry / Better Stack は採用しない (#1179) ので、それ用の環境変数は置かない。
#
# エラー急増の運用メール (#1157): app_logs のサーバーの level=error が 15 分で 20 件を超えたら、このアドレスへ 1 通知らせる。
# ブラウザ・端末から POST /api/log で届いた error (source=client) は別に数え、15 分で 100 件を超えたら別の通知を送る (#1493)。
# 届けられなかったメール (送信待ち email_outbox の dead) も 1 件から、このアドレスへ知らせる (#1193。画面は /super-admin/email-outbox)。
# Vercel Cron が 15 分おきに GET /api/cron/app-log-alerts を呼ぶ。同じ通知は 60 分は送り直さない (2 種類の通知は別々に数える)。
# DB バックアップの鮮度の通知 (#1129) もこのアドレスへ送る: Vercel Cron が日 1 回 (14:37 JST) GET /api/cron/backup-freshness を呼び、
# 最新の取得 (backup.daily.completed) が 30 時間より古ければ 1 通知らせる (日 1 回の確認で、古ければ 1 通。古いままなら翌日も 1 通)。
# メールアドレスを 1 つだけ書く (「名前 <アドレス>」の形や、カンマ区切りの複数は不可)。個人のアドレスでよい。
# 未設定なら通知しない (どちらの cron も動くが、info ログを 1 行残すだけ)。メールが実際に届くには、送信元ドメインの検証が要る
# (RESEND_API_KEY / EMAIL_FROM。docs/operations/email-domain.md)。手順の詳細は ENV_SETUP.md。
OPS_ALERT_EMAIL=
# しきい値とクールダウンの上書き (任意。空なら既定のサーバー 20 件・ブラウザ/端末 100 件・60 分)。整数だけ。範囲外・整数でない値は既定値に戻る (warn ログが残る)。
# しきい値は 1〜100000 (15 分でこの件数を「超えたら」通知)、クールダウンは 1〜10080 分 (同じ通知を送り直さない時間)。
OPS_ALERT_ERROR_THRESHOLD=
OPS_ALERT_CLIENT_ERROR_THRESHOLD=
OPS_ALERT_COOLDOWN_MINUTES=
# pg_cron の停止の通知のしきい値の上書き (任意。#1125 の B)。空なら既定の 60 分。10〜1440 の整数 (分)。範囲外・整数でない値は既定値に戻る (warn ログが残る)。
# 有効なジョブがあるのに、最新の実行からこの分数を「超えて」1 つも動いていなければ、同じ宛先に知らせる。
# 定期処理の失敗 (pg_cron の失敗した実行・Vercel Cron の route の 500) も 1 件から同じ cron・同じ宛先・同じ抑止の分数で知らせる (docs/design/operator/11-ops-batches-non-billing.md)。
OPS_ALERT_PG_CRON_STALL_MINUTES=
# cron の共有シークレットの入れ替えの途中・旧い値の残り (WARN) の通知の抑止 (任意。#1560)。空なら既定の 1440 分 (24 時間)。1440〜10080 の整数 (分。1 日 1 通までより短くしない)。範囲外・整数でない値は既定値に戻る (warn ログが残る)。
# ずれ (FAIL: Edge Function secrets の CRON_SECRET と Vault の app_cron_secret の食い違いなど) は OPS_ALERT_COOLDOWN_MINUTES の抑止で、同じ cron・同じ宛先に知らせる (docs/design/operator/12-cron-secret-drift-monitor.md)。
OPS_ALERT_CRON_SECRET_ROTATION_COOLDOWN_MINUTES=

# ---- Push 通知の送信 (Expo Push Service。#1136。任意) ----
# Vercel Cron が毎分 GET /api/cron/push-outbox を呼び、送信待ち (push_outbox) の通知を Expo に送る (docs/design/mobile/06-push-send.md)。
# EXPO_ACCESS_TOKEN: Expo のアクセストークン (サーバー専用・秘密)。Expo プロジェクトの Enhanced push security を ON にしたうえで、
#   expo.dev/settings/access-tokens で作る。未設定なら Push 通知を送らない (cron は warn ログを 1 行残し、掃除だけをする:
#   24 時間を超えた送信待ちの行を expired にし、送信済みは 7 日・届けられなかった行は 30 日で消す)。手順の詳細は ENV_SETUP.md。
EXPO_ACCESS_TOKEN=
# 試行の上限 (1〜10。空なら 3 回) と、1 回の cron で送る件数の上限 (1〜500。空なら 100 件)。整数だけ。
# 範囲外・整数でない値は既定値に戻る (warn ログに変数名だけが残る)。
PUSH_OUTBOX_MAX_ATTEMPTS=
PUSH_OUTBOX_BATCH_SIZE=

# ---- Cron 認証 (Vercel Cron 用) ------------------------
CRON_SECRET=
# CRON_SECRET を入れ替える間だけ、旧い値を入れる。入れ替えが終わったら空に戻す。空・未設定なら無視される。
# 同じ名前を Supabase の Edge Function secrets にも設定できる。手順は ENV_SETUP.md の「Cron の共有シークレットの保管場所とローテーション」を参照
CRON_SECRET_PREVIOUS=

# ---- Supabase Edge Functions の CORS (#1167) -----------
# 注: このアプリ (Next.js) の環境変数ではなく、Edge Function の Secret
#     (Supabase Dashboard → Edge Functions → Secrets、または `supabase secrets set`) に設定する。
# ブラウザから Edge Function を直接呼ぶときに許可するオリジン (カンマ区切り、スキーム付き・末尾スラッシュなし)。
# 未設定なら、いまアプリが動いている https://homegohan-app.vercel.app だけを許可する (設定すると置き換わる)。
# サイトを homegohan.com に移したら、そのオリジンを足す (docs/operations/email-domain.md)。
# '*' と 'null' は指定しても無視される。サーバー間の呼び出し (Next.js の API ルートなど) には影響しない。
# ALLOWED_ORIGINS=https://homegohan-app.vercel.app,http://localhost:3000

# ---- モバイル WebView 認証ブリッジ (#1036、オプション) ----
# 旧方式 (GET /auth/native-bridge?access_token=...&refresh_token=... でトークンを URL に載せる) の受け付けを制御する。
# 旧方式は URL がアクセスログに残りトークンが漏れるため、受け付けを止めている (426 で「アプリを最新版に更新してください」を返す)。
# 期限は src/lib/auth/native-bridge-code.ts の LEGACY_SUNSET_AT (2026-10-18 00:00 JST。過ぎているので、この変数に依らず常に 426)。
#   未設定 / off 以外: LEGACY_SUNSET_AT まで受け付ける (いまは過ぎているので受け付けない。環境変数で期限は延ばせない)
#   off: 期限の前でも受け付けない。コード方式には影響しない
#   Vercel で変えた場合は、再デプロイ後に効く
# NATIVE_BRIDGE_LEGACY_GET=off

# ---- 利用規約・プライバシーポリシーへの再同意の強制 (#1174、オプション) ----
# 同意済みの版が packages/shared/src/legal-versions.ts の LEGAL_DOCUMENTS (いま有効な版) と食い違う、
# サインイン中の利用者を、同意画面 (/legal-consent) へ回すかどうか。
#   未設定 / on 以外: 既存の利用者は回さない (既定。お知らせを出すかは、下の LEGAL_CONSENT_NOTICE で決まる)
#   ただし初めてサインインした新規の人は、この値に関わらず /auth/callback が同意画面へ回す (#1435)
#   on: 同意が済むまで、画面 (規約・特商法・問い合わせ・認証の途中の画面などを除く) を開くと同意画面へ回し、
#       /api/* (同意そのもの・認証・退会と書き出し・問い合わせ・ログなどの許可リストを除く) は 403 で止める (#1442)。
#       アプリも起動時に同意画面を出す
# 強制を始める日は、版・施行日・同意文言 (弁護士の確認) が決まってから、オーナーが決める。
# Vercel で変えた場合は、再デプロイ後に効く。詳細は ENV_SETUP.md を参照
# LEGAL_CONSENT_ENFORCE=off
#
# 同意が済んでいない、サインイン中の利用者の画面の上に「同意のお願い」のお知らせ (同意画面へのリンク) を出すかどうか。
# 強制 (LEGAL_CONSENT_ENFORCE=on) していない間だけ効く (強制しているときは、お知らせではなく同意画面へ回す)。
#   未設定 / on 以外: 出さない (既定)。未同意の人にも何も表示しない
#   on: (main) の画面の上にお知らせを出す。使うのは止めない
# サーバー側 (middleware) だけで読む (NEXT_PUBLIC_ にしない)。値の読み方は LEGAL_CONSENT_ENFORCE と同じ
# (大文字小文字と前後の空白は区別しない)。Vercel で変えた場合は、再デプロイ後に効く
# LEGAL_CONSENT_NOTICE=off

# ---- CSP を「報告だけ」にする (#1169、オプション) ----
# 本番の Content-Security-Policy は script-src に 'unsafe-inline' を持たず、毎リクエストの nonce で Next のスクリプトだけを許す。
# ローンチ後に、ある画面でスクリプトが止まる報告 (app_logs の function_name = csp-report) が集まったときの戻し方。
#   未設定 / on 以外: 強制する (既定)。違反は止まり、報告も届く
#   on: Content-Security-Policy-Report-Only で返し、違反を止めず報告だけ届かせる。直近 7 日に inline / eval / 自オリジンの報告が 0 件になったら外す
# サーバー側 (middleware) だけで読む (NEXT_PUBLIC_ にしない)。値の読み方は LEGAL_CONSENT_ENFORCE と同じ。Vercel で変えた場合は、再デプロイ後に効く
# CSP_REPORT_ONLY=off

# ---- 運営の機能フラグ一覧の対象ユーザー数 (#1148、オプション) ----
# 運営画面 (/super-admin/flags) は、段階公開・条件つきのフラグの対象ユーザー数を、ユーザーを 1 人ずつ判定して数える。
# ユーザーがこの数を超えると数えず、その数は「—」になる (全員が対象で条件の無いフラグは、件数だけを数えるので常に出る)。
#   未設定 / 正の整数でない: 20000 (既定)
# FEATURE_FLAG_ACTIVE_USER_SCAN_LIMIT=20000

# ---- 個人情報の請求の応答期限 (#1178、オプション) ----
# 開示・訂正・利用停止・消去の請求を受け付けた (本人確認が済んだ) 時点から、応答の期限までの日数。受付の時点で期限を保存する。
#   未設定 / 1〜365 の 10 進の整数でない: 30 (既定)
# DSR_RESPONSE_DUE_DAYS=30

# ---- 機能フラグの行をメモリに覚える時間 (#1496、オプション。本番では設定しない) ----
# 運営画面で機能フラグを切り替えてから、全員に反映されるまでの最大の遅れ (ミリ秒)。
# 結合テストの段 (security-regression.yml / scripts/local-ci.sh) が起動する next dev だけが短くする。
# 値は正の整数を 10 進の数字だけで書く (前後の空白を除いて先頭が 1〜9。1e3・0x7D0・2000.0・+2000 は受け付けない。#1535)。
#   未設定 / 10 進の数字だけの正の整数でない: 30000 (既定。30 秒)
# FEATURE_FLAG_CACHE_TTL_MS=30000

# ---- 献立の単発追加の開始日のずらしの上限 (#1463、オプション) ----
# POST /api/menu-plans/add の date_offset_days (開始日を JST の今日から何日ずらすか) の絶対値の上限。超える値は 400。
#   未設定 / 正の整数でない: 366 (既定。前後 1 年)
# MENU_PLANS_ADD_MAX_DATE_OFFSET_DAYS=366

# ---- 食事写真・冷蔵庫写真の署名付き URL の有効期限 (#1365、オプション) ----
# 画面は保存された写真の URL をそのまま表示せず、POST /api/storage/signed-urls が本人の写真だけに署名した URL を表示する。
#   未設定 / 60 以上 86400 以下の整数でない: 3600 (既定。1 時間)
# PHOTO_SIGNED_URL_TTL_SECONDS=3600

# ---- 献立生成の究極モードの 1 日の上限 (#1142、オプション) ----
# 究極モードは、1 日の AI の上限 (DB の ai_daily_limits) とは別に、利用者ごと・1 日 (JST の暦日) にこの回数まで。
# ただしこの値が効くのは、DB の ai_plan_feature_caps に行の無いプラン (組織のプランなど) だけ。行のあるプラン
# (free 0 / pro 2 / family_basic 2 / family_pro 3。0 はそのプランでは使えない) は行の値で決まる (billing/03 §6.5)
#   未設定 / 0 以上の整数でない: 1 (既定。AI_ULTIMATE_MODE_DAILY_LIMIT_DEFAULT)
#   0 以上の整数: その回数まで (0 はその日は 1 回も使えない)
# Edge Functions (Supabase の secrets) にも同じ値を入れる (片方だけだと、入口によって上限が変わる)
# AI_ULTIMATE_MODE_DAILY_LIMIT=1

# コード方式の bridge が WebView の Cookie に入れる refresh_token の扱い (#1038 F7-05、オプション)。
# ネイティブと Web が同じ refresh_token を別々に更新すると、Supabase が再利用とみなしてセッションごと失効させ、突然のログアウトになる。
#   未設定 / on 以外: 更新に使えない値 (src/lib/native-auth-bridge.ts の NATIVE_BRIDGE_WEB_REFRESH_TOKEN_PLACEHOLDER) を入れる。
#     Web は自分で更新せず、期限が近づく・切れると、ネイティブに再ブリッジ (WebView の読み込み直し) を頼む。
#     ネイティブがそれを処理する新しいビルドが前提で、旧方式 (トークンを URL で渡す) のアプリには影響しない
#   on: 実際の refresh_token を入れる (従来の動作)。再ブリッジに実機で問題が見つかったときに、コードを変えずに戻すためのスイッチ
#   Vercel で変えた場合は、再デプロイ後に効く
# NATIVE_BRIDGE_SHARE_REFRESH_TOKEN=on

# ---- 組織チャレンジ (#1132、オプション) ----------------
# チャレンジの順位表に、参加者のニックネーム (表示名) を出すか。
# 参加者どうしに表示名を見せてよいかは、社内の方針の確認待ち。決まるまでは未設定のままにする。
#   未設定 / 下の値以外: 出さない (順位と記録だけ。本人は「あなた」、ほかの人は「参加者」と表示する)
#   1 / true / on / yes: 出す (大文字小文字・前後の空白は無視)
#   サーバー側だけで読む (NEXT_PUBLIC_ にしない)。Vercel で変えた場合は、再デプロイ後に効く
# ORG_CHALLENGE_SHOW_NAMES=

# ---- E2E テスト用 (CI / ローカル E2E) ------------------
# 実値は CI Secret に置き、ローカルは .env.local に
E2E_USER_EMAIL=
# 注: # を含むパスワードはダブルクォートで囲む
E2E_USER_PASSWORD=""
PLAYWRIGHT_BASE_URL=https://homegohan-app.vercel.app

# ---- バージョン表示 (CI で自動注入推奨) ----------------
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_BUILD_DATE=
